{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kblabs.ru/schemas/errors.catalog.schema.json",
  "title": "KB Labs error catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "codes"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "codes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "area", "stage", "severity", "retryable", "processExitClass", "message", "hint"],
        "properties": {
          "code": { "type": "string", "pattern": "^KB_[A-Z]+(_[A-Z0-9]+)+$" },
          "httpStatus": { "type": "integer", "minimum": 100, "maximum": 599, "description": "HTTP status for errors surfaced by an HTTP boundary. Omitted when the code is not surfaced over HTTP; an omitted value at an HTTP boundary is a contract defect." },
          "area": { "$ref": "error-envelope.schema.json#/properties/area" },
          "stage": { "$ref": "error-envelope.schema.json#/properties/stage" },
          "severity": { "$ref": "error-envelope.schema.json#/properties/severity" },
          "retryable": { "type": "boolean" },
          "processExitClass": { "enum": ["input-refusal", "operation-failure"], "description": "Canonical Go CLI process-exit class for every catalogued diagnostic." },
          "message": { "type": "string", "minLength": 1, "description": "Template; {name} placeholders are filled from details." },
          "hint": { "type": "string", "minLength": 1, "description": "Template; {name} placeholders are filled from details." },
          "deprecated": { "type": "boolean" }
        }
      }
    }
  }
}
