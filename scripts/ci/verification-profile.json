{
  "schemaVersion": 1,
  "buildStage": "workspace-build",
  "packageTestStage": "workspace-unit-tests",
  "maxParallel": 20,
  "shardTimeoutMinutes": 30,
  "stages": {
    "workspace-build": { "runner": "kb-devkit-build" },
    "workspace-unit-tests": { "runner": "kb-devkit-test" },
    "internal-tool-tests": { "runner": "kb-devkit-internal-tool-suite" },
    "ci-script-suite": { "runner": "node-test-directory", "directory": "scripts/ci" },
    "kb-create-go-suite": { "runner": "node-script", "script": "scripts/ci/go-module-suite.mjs", "args": ["--module", "tools/kb-create"] },
    "kb-devkit-check": { "runner": "executable", "command": "./tools/kb-devkit/kb-devkit", "args": ["check"] },
    "journey-unit-suite": { "runner": "process", "command": "python3", "args": ["-m", "unittest", "discover", "-s", "e2e/journey", "-p", "test_*.py"] }
  },
  "independentTestStages": {
    "stream": ["ci-script-suite"],
    "candidate": ["ci-script-suite", "kb-create-go-suite", "kb-devkit-check"]
  },
  "buildDependentTestStages": {
    "stream": [],
    "candidate": ["journey-unit-suite"]
  }
}
