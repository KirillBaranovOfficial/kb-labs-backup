          "tarball": "http://verdaccio:4873/@kb-labs/gateway-app/-/gateway-app-2.120.1.tgz",
          "config": [
            {
              "id": "gateway.access.mode",
              "path": "/gateway/access/mode",
              "default": "\"local\"",
              "hint": "Studio access: \"secured\" requires login; \"local\" is a no-login install that binds loopback only"
            },
            {
              "id": "gateway.bootstrap.adminEmail",
              "path": "/gateway/auth/bootstrap/adminEmail",
              "hint": "Email of the first administrator (secured access)"
            },
            {
              "id": "gateway.bootstrap.tenantId",
              "path": "/gateway/auth/bootstrap/tenantId",
              "hint": "Tenant that owns the first administrator; leave unset to use GATEWAY_BOOTSTRAP_TENANT_ID or the gateway default (kblabs-cloud)"
            },
            {
              "id": "gateway.bootstrap.password",
              "secret": true,
              "env": "GATEWAY_BOOTSTRAP_ADMIN_PASSWORD",
              "services": [
                "gateway"
              ],
              "hint": "Password of the first administrator; without it no admin is created (recover later with `kb-create doctor --recover`)"
            },
            {
              "id": "gateway.jwtSecret",
              "secret": true,
              "generate": true,
              "env": "GATEWAY_JWT_SECRET",
              "services": [
                "gateway"
              ],
              "hint": "HMAC secret that signs session tokens (e.g. `openssl rand -hex 64`); without it the gateway uses a public development secret"
            },
            {
              "id": "gateway.internalSecret",
              "secret": true,
              "generate": true,
              "env": "GATEWAY_INTERNAL_SECRET",
              "services": [
                "gateway",
                "rest",
                "marketplace-registry"
              ],
              "hint": "Shared gateway-to-service authentication secret; kb-create generates and preserves it"
            },
            {
              "id": "gateway.authStorage.filename",
              "path": "/platform/adapterOptions/documentDatabase/filename",
              "default": "\".kb/database/kb.sqlite\"",
              "hint": "Persistent database file for secured gateway identity, session, invite, and reset data"
            }
          ]
        },
