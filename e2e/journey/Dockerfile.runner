FROM node:24-bookworm

RUN apt-get update -qq && apt-get install -y -qq ca-certificates curl git jq python3 procps iproute2 lsof \
    && npm install -g pnpm@12.8.1 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.local/bin:/root/.local/share/pnpm:$PATH"
COPY tools/kb-create/install.sh /usr/local/share/kb-create/install.sh
COPY e2e/journey/runner.py /usr/local/bin/kb-journey-runner
COPY e2e/journey/service_steps.py e2e/journey/service_runner.py /usr/local/share/kb-create/
RUN chmod +x /usr/local/share/kb-create/install.sh /usr/local/bin/kb-journey-runner

ENTRYPOINT ["python3", "/usr/local/bin/kb-journey-runner"]
